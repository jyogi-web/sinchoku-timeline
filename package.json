{
  "name": "sinchoku-timeline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply sinchoku-timeline --local",
    "db:migrate:remote": "wrangler d1 migrations apply sinchoku-timeline --remote",
    "register-commands": "node --env-file=.dev.vars scripts/register-commands.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.40.0"
  }
}
